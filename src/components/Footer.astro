---
import SocialLinks from './SocialLinks.astro';

const links = [
  { href: '/games', label: 'Games' },
  { href: '/services', label: 'Services' },
  { href: '/training', label: 'Training demo' },
  { href: '/about', label: 'About' },
  { href: '/press', label: 'Press Kit' },
  { href: '/contact', label: 'Contact' },
];

const wishlists = [
  { label: 'Krodha', href: 'https://store.steampowered.com/app/3759340/' },
  { label: 'Dissonant', href: 'https://store.steampowered.com/app/3006030/Dissonant/' },
  { label: 'Dissonant free demo', href: 'https://store.steampowered.com/app/4285210/' },
];
---

<footer class="bg-charcoal py-16">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="font-display text-snow text-2xl tracking-wider mb-6">!HOW GAME STUDIO</p>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mb-6">
      {links.map((link, i) => (
        <>
          <a href={link.href} class="text-smoke hover:text-mint transition-colors text-sm font-body">{link.label}</a>
          {i < links.length - 1 && <span class="text-fade">|</span>}
        </>
      ))}
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
      <span class="text-smoke/60 text-xs font-body uppercase tracking-[0.15em]">On Steam:</span>
      {wishlists.map(w => (
        <a href={w.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-mint hover:text-snow transition-colors text-sm font-body font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 12.004-5.373 12.004-12S18.606 0 11.979 0z"/></svg>
          {w.label}
        </a>
      ))}
    </div>

    <div class="flex justify-center mb-8">
      <SocialLinks color="mint" />
    </div>

    <div class="border-t border-fade pt-6 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-smoke/70 text-sm">&copy; 2026 !How Game Studio</p>
      <p class="text-smoke/70 text-sm">Designed by Skkyee</p>
    </div>
  </div>
</footer>
