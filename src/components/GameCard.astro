---
interface Props {
  title: string;
  slug: string;
  tagline: string;
  status: string;
  genre: string[];
  image?: string;
  steam?: string;
  demo?: string;
}

const { title, slug, tagline, status, genre, image, steam, demo } = Astro.props;

const statusLabel = demo ? 'Free Demo' : status.includes('Early Access') ? 'Early Access 2027' : 'In Development';
---

<div class="bg-surface rounded-xl overflow-hidden border border-fade hover:-translate-y-2 hover:border-mint transition-all duration-500 hover:shadow-[0_0_30px_rgba(157,212,185,0.2)] group cursor-pointer">
  <!-- Image -->
  <div class="aspect-video bg-charcoal relative overflow-hidden">
    {image ? (
      <img src={image} alt={`${title} screenshot`} width="920" height="430" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <span class="font-display text-snow/10 text-4xl tracking-[0.3em] group-hover:text-snow/25 group-hover:tracking-[0.5em] transition-all duration-700">{title.toUpperCase()}</span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-surface/80 to-transparent pointer-events-none"></div>
    <!-- Corner accents -->
    <div class="absolute top-3 left-3 w-6 h-6 border-t-2 border-l-2 border-mint/0 group-hover:border-mint/50 transition-all duration-500"></div>
    <div class="absolute bottom-3 right-3 w-6 h-6 border-b-2 border-r-2 border-mint/0 group-hover:border-mint/50 transition-all duration-500"></div>
  </div>
  <div class="p-6">
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-display text-snow text-2xl">{title.toUpperCase()}</h3>
      <span class="bg-mint/15 text-mint text-xs font-body px-3 py-1 rounded-full border border-mint/20 whitespace-nowrap">
        {statusLabel}
      </span>
    </div>
    <p class="text-smoke text-[15px] mb-4 leading-relaxed">{tagline}</p>
    <div class="flex flex-wrap gap-2">
      {genre.map(g => (
        <span class="bg-charcoal text-smoke text-xs px-2.5 py-1 rounded-full font-body border border-fade/50 group-hover:text-mint group-hover:border-mint/30 transition-colors duration-300">{g}</span>
      ))}
    </div>
    {(steam || demo) && (
      <div class="mt-5 flex flex-wrap gap-3">
        {steam && (
      <a href={steam} target="_blank" rel="noopener noreferrer" data-cursor-hover class="inline-flex items-center gap-2 bg-crimson text-white text-xs font-body font-semibold uppercase tracking-[0.1em] rounded-lg px-4 py-2.5 hover:bg-crimson-dark transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 12.004-5.373 12.004-12S18.606 0 11.979 0z"/></svg>
        Wishlist on Steam
      </a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" data-cursor-hover class="inline-flex items-center gap-2 border border-mint text-mint text-xs font-body font-semibold uppercase tracking-[0.1em] rounded-lg px-4 py-2.5 hover:bg-mint hover:text-charcoal transition-colors">
            Play free demo
          </a>
        )}
      </div>
    )}
  </div>
</div>
