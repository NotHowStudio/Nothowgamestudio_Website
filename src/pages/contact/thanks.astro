---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent · !How Game Studio" description="Thanks for getting in touch with !How Game Studio." noindex>
  <section class="min-h-screen bg-crimson flex flex-col items-center justify-center text-center px-6 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-64 h-64 border border-white/5 rounded-full"></div>
      <div class="absolute bottom-1/4 right-1/4 w-48 h-48 border border-white/5 rotate-45"></div>
    </div>

    <div class="relative z-10">
      <h1 class="font-display text-white text-[56px] md:text-[72px] leading-none mb-4">MESSAGE SENT</h1>
      <p class="font-body text-snow/85 text-lg mb-8 max-w-lg md:max-w-none md:whitespace-nowrap">Thanks for writing. We'll get back to you using the details you gave us.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="magnetic-btn inline-block bg-charcoal text-white font-body font-medium text-sm uppercase tracking-[0.1em] rounded-lg px-8 py-3 hover:bg-night transition-colors">BACK TO HOME</a>
        <a href="/training/sop-sample/" class="magnetic-btn inline-block border border-white text-white font-body font-medium text-sm uppercase tracking-[0.1em] rounded-lg px-8 py-3 hover:bg-white hover:text-crimson transition-colors">PLAY THE TRAINING DEMO</a>
      </div>
    </div>
  </section>
</BaseLayout>
